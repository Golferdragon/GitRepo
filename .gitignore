# Executables and binaries
*.exe
*.bin
*.elf
*.hex
*.map
*.o
*.obj

# Rust build output
target/

# STM32 / Eclipse / CubeIDE build output
Debug/
Release/

# Logs and temporary files
*.log
*.tmp

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Optional: STM32CubeIDE workspace metadata
.metadata/

# Work-in-progress embedded projects
# Keep the folder locally, but do not publish project contents.
STM32Projects/WorkInProgress/*

# Allow a placeholder and README so the directory still appears in GitHub.
!STM32Projects/WorkInProgress/.gitkeep
!STM32Projects/WorkInProgress/README.md
